<view class="app data-v-5fce1cf3"><view class="banner data-v-5fce1cf3">仅支持对已完成订单中的商品进行评价，同一订单同一商品只可评价一次。</view><view class="card data-v-5fce1cf3"><text class="title data-v-5fce1cf3">选择要评价的商品</text><view wx:if="{{a}}" class="tip data-v-5fce1cf3">加载中…</view><text wx:elif="{{b}}" class="tip data-v-5fce1cf3">暂无可评价的订单商品</text><view wx:else class="pending-list data-v-5fce1cf3"><view wx:for="{{c}}" wx:for-item="p" wx:key="f" class="{{['pending-item', 'data-v-5fce1cf3', p.e && 'active']}}" bindtap="{{p.g}}"><image class="pic data-v-5fce1cf3" src="{{p.a}}" mode="aspectFill"></image><view class="info data-v-5fce1cf3"><text class="name data-v-5fce1cf3">{{p.b}}</text><text class="sub data-v-5fce1cf3">{{p.c}}</text><text class="sub data-v-5fce1cf3">订单号：{{p.d}}</text></view></view></view></view><view class="card data-v-5fce1cf3"><text class="title data-v-5fce1cf3">打分</text><view class="star-row data-v-5fce1cf3"><text wx:for="{{d}}" wx:for-item="st" wx:key="b" class="{{['star', 'data-v-5fce1cf3', st.a && 'active']}}" bindtap="{{st.c}}">★</text><text class="star-tip data-v-5fce1cf3">{{e}} 分</text></view><text class="title data-v-5fce1cf3">评价内容</text><block wx:if="{{r0}}"><textarea class="input data-v-5fce1cf3" maxlength="{{500}}" placeholder="说说这件商品怎么样（1-500字）" value="{{f}}" bindinput="{{g}}"/></block></view><view class="card data-v-5fce1cf3"><button class="btn-primary data-v-5fce1cf3" disabled="{{h}}" bindtap="{{i}}">提交评价</button></view></view>