<view class="container"><view class="list-cell b-b m-t" bindtap="{{a}}" hover-class="cell-hover" hover-stay-time="{{50}}"><text class="cell-tit">个人资料</text><text class="cell-more yticon icon-you"></text></view><view class="list-cell b-b" bindtap="{{b}}" hover-class="cell-hover" hover-stay-time="{{50}}"><text class="cell-tit">收货地址</text><text class="cell-more yticon icon-you"></text></view><view class="list-cell" bindtap="{{c}}" hover-class="cell-hover" hover-stay-time="{{50}}"><text class="cell-tit">联系资料</text><text class="cell-more yticon icon-you"></text></view><view class="list-cell m-t"><text class="cell-tit">消息推送</text><switch checked color="{{d}}" bindchange="{{e}}"/></view><view class="list-cell m-t b-b"><text class="cell-tit">主题换肤</text><view class="theme-options"><text wx:for="{{f}}" wx:for-item="t" wx:key="b" class="{{['theme-option', t.c]}}" style="{{t.d}}" bindtap="{{t.e}}">{{t.a}}</text></view></view><view class="list-cell m-t b-b" bindtap="{{g}}" hover-class="cell-hover" hover-stay-time="{{50}}"><text class="cell-tit">清除缓存</text><text class="cell-more yticon icon-you"></text></view><view class="list-cell"><text class="cell-tit">检查更新</text><text class="cell-tip">当前版本 1.0.0</text><text class="cell-more yticon icon-you"></text></view><view class="list-cell log-out-btn" bindtap="{{h}}"><text class="cell-tit">退出登录</text></view></view>