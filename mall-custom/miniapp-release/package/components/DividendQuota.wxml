<view class="account-panel dividend-quota data-v-80f77fa5"><view class="quota-heading data-v-80f77fa5"><text class="data-v-80f77fa5">分红额度</text><text class="quota-link data-v-80f77fa5" bindtap="{{a}}">明细 ›</text></view><view class="quota-status data-v-80f77fa5"><text class="data-v-80f77fa5">{{b}}</text><text class="quota-refresh data-v-80f77fa5" bindtap="{{d}}">{{c}}</text></view><view class="quota-total data-v-80f77fa5"><text class="quota-currency data-v-80f77fa5">¥</text><text class="data-v-80f77fa5">{{e}}</text><text class="quota-caption data-v-80f77fa5">剩余额度</text></view><view class="quota-summary data-v-80f77fa5"><view class="data-v-80f77fa5"><text class="data-v-80f77fa5">¥{{f}}</text><text class="data-v-80f77fa5">累计分红上限</text></view><view class="data-v-80f77fa5"><text class="data-v-80f77fa5">¥{{g}}</text><text class="data-v-80f77fa5">累计已领</text></view></view><view wx:if="{{h}}" class="quota-pools data-v-80f77fa5"><view wx:for="{{i}}" wx:for-item="pool" wx:key="g" class="quota-pool data-v-80f77fa5"><view class="quota-pool-heading data-v-80f77fa5"><text class="data-v-80f77fa5">{{pool.a}}</text><text class="data-v-80f77fa5">{{pool.b}}</text></view><view class="quota-progress data-v-80f77fa5"><view class="data-v-80f77fa5" style="{{'width:' + pool.c}}"/></view><view class="quota-pool-detail data-v-80f77fa5"><text class="data-v-80f77fa5">已领 ¥{{pool.d}} / {{pool.e}}</text><text class="data-v-80f77fa5">池余额 {{pool.f}}</text></view></view></view><view wx:if="{{j}}" class="quota-note data-v-80f77fa5" bindtap="{{k}}">购买会员后获得分红额度，查看会员权益 ›</view><view wx:else class="quota-note data-v-80f77fa5">上方剩余额度是个人累计可领上限；下方池余额是各分红池当前资金，实际到账以分红明细为准。</view></view>