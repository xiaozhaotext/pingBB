[Unit]
Description=Mall membership purchase sandbox API
After=network-online.target mysql.service redis-server.service rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=mall-demo
Group=mall-demo
WorkingDirectory=/opt/mall-demo
EnvironmentFile=/etc/mall-demo/portal.env
ExecStart=/usr/bin/java -Xms96m -Xmx384m -jar /opt/mall-demo/mall-portal-sandbox.jar --spring.profiles.active=dev --server.address=127.0.0.1 --server.port=8086 --spring.datasource.url=jdbc:mysql://127.0.0.1:3306/mall_demo_sandbox --spring.data.redis.database=1 --spring.data.mongodb.database=mall-port-sandbox --spring.rabbitmq.virtual-host=/mall_sandbox --mall.p0.consumer-simulation-enabled=false --mall.membership.payment.enabled=false --mall.payment.mock.enabled=true --mall.registration.test-accounts.enabled=true --mall.dividend.schedule.enabled=false --mall.public-base-url=https://122.51.105.107/sandbox
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/mall-demo

[Install]
WantedBy=multi-user.target
