# Docker Compose 环境变量模板
# 用法： cp .env.example .env   然后按需修改
# 说明： 不建 .env 也能直接跑起来 —— docker-compose.yml 里的默认值与下面完全一致，
#        且与应用配置 deploy/application-docker.yml 的 spring.datasource.password 一致。
#        只有想换端口、改密码时才需要 cp 成 .env 再改。
#        改密码时务必同步改 deploy/application-docker.yml 里的 password，否则后端连不上库。

COMPOSE_PROJECT_NAME=mall

# MySQL root 密码（仅 MySQL 容器自身与健康检查使用，应用不用 root 连接）
MYSQL_ROOT_PASSWORD=mall123456
# MySQL 应用账号 reader 的密码 —— 必须与 deploy/application-docker.yml 的 spring.datasource.password 保持一致
MYSQL_PASSWORD=123456

# 前端对外端口（浏览器访问 http://服务器IP:8080）
FRONTEND_PORT=8080
# 后端端口（nginx /portal 代理到 backend:8085；application-docker.yml 的 server.port 也是 8085，三者必须一致）
BACKEND_PORT=8085
