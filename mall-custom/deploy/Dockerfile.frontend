# 前端镜像：构建 H5 静态包并用 nginx 托管
# 构建上下文为 mall-custom，前端源码在 mall-app-web/ 下
FROM node:20-alpine AS build
WORKDIR /web
COPY mall-app-web /web
# 国内可换镜像加速：RUN npm config set registry https://registry.npmmirror.com
RUN npm install
# build:h5 = uni build（取 .env.production 的 VITE_API_BASE_URL=/portal）
RUN npm run build:h5

FROM nginx:alpine
COPY --from=build /web/dist/build/h5 /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
