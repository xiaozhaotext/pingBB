# Copy outside the repository; set root ownership and mode 0600.
# Both mall-portal and mall-admin must load this EnvironmentFile.
MALL_SMS_ENABLED=false
MALL_SMS_PROVIDER=TENCENT
MALL_SMS_ENVIRONMENT=production
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_ID=
# SendSms requires the approved sign text, not its numeric ID.
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SANDBOX_TEST_MODE=false
