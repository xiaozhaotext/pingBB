server {
  listen 80;
  server_name _;
  client_max_body_size 10m;
  location /api/ { proxy_pass http://127.0.0.1:8000/api/; proxy_set_header Host $host; proxy_set_header X-Request-ID $request_id; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  location /healthz { proxy_pass http://127.0.0.1:8000/healthz; }
  location /readyz { proxy_pass http://127.0.0.1:8000/readyz; }
  location /admin/ { alias /srv/ecommerce/apps/admin/dist/; try_files $uri $uri/ /admin/index.html; }
  location /merchant/ { alias /srv/ecommerce/apps/merchant/dist/; try_files $uri $uri/ /merchant/index.html; }
  location / { root /srv/ecommerce/apps/storefront/dist; try_files $uri $uri/ /index.html; }
}
