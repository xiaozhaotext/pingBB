[Unit]
Description=Ecommerce FastAPI service
After=network.target

[Service]
Type=simple
User=ecommerce
Group=ecommerce
WorkingDirectory=/srv/ecommerce/apps/api
EnvironmentFile=/etc/ecommerce/ecommerce.env
ExecStart=/srv/ecommerce/venv/bin/uvicorn app.asgi:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/ecommerce

[Install]
WantedBy=multi-user.target
